# Local-only defaults. NEVER use these secrets in production.
POSTGRES_USER=securewallet
POSTGRES_PASSWORD=securewallet
POSTGRES_DB=securewallet_auth
POSTGRES_PORT=5432
REDIS_PORT=6379
AUTH_HTTP_PORT=8081
WALLET_HTTP_PORT=8082
LOG_LEVEL=info

JWT_ISSUER=securewallet-auth
JWT_TTL=1h
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
INTERNAL_API_TOKEN=dev-only-internal-token-change-me-123456

CARD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CARD_FINGERPRINT_KEY=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=

AUTH_DATABASE_URL=postgres://securewallet:securewallet@postgres:5432/securewallet_auth?sslmode=disable
WALLET_DATABASE_URL=postgres://securewallet:securewallet@postgres:5432/securewallet_wallet?sslmode=disable
REDIS_URL=redis://redis:6379/0
AUTH_SERVICE_URL=http://auth-service:8081
AUTH_SERVICE_TIMEOUT=3s
BALANCE_CACHE_TTL=5m

NOTIFICATIONS_FILE=/var/lib/securewallet/notifications.log
NOTIFICATION_BUFFER=1024

# Consumed by `go run` outside Docker after changing hosts to localhost.
# DATABASE_URL=postgres://securewallet:securewallet@localhost:5432/securewallet_wallet?sslmode=disable
